{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Bold",
	"settings": {
		"custom": {
			"basix": {
				"order": 2,
				"description": "High contrast, violet accent and a geometric heading font.",
				"light": {
					"background": "#FFFFFF",
					"surface": "#F1F0F7",
					"text": "#0E0B1A",
					"textSecondary": "#4B4860",
					"divider": "#DCD9EA",
					"accent": "#6D28D9"
				},
				"dark": {
					"background": "#0C0A16",
					"surface": "#151227",
					"text": "#F3F1FF",
					"textSecondary": "#B5B0D0",
					"divider": "#2F2A4A",
					"accent": "#7C3AED"
				},
				"radius": "sharp",
				"fonts": {
					"heading": "space-grotesk",
					"body": "inter"
				}
			}
		}
	}
}
