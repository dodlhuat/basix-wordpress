# One set of basics for every editor. PHP follows the WordPress coding standard (tabs), checked by phpcs.xml.dist.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.php]
indent_style = tab
indent_size = 4

[{*.js,theme/assets/js/*.js}]
indent_size = 4

[scripts/**.{mjs,js}]
indent_size = 2

[*.css]
indent_size = 4

[*.{md,txt}]
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab

[*.po]
trim_trailing_whitespace = false
